{
	"name": "obsidian-protected-notes",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Encrypt Markdown notes with secrets stored in 1Password.",
	"main": "main.js",
	"author": "Deepal Jayasekara",
	"license": "MIT",
	"engines": { "node": ">=24.15.0" },
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test test/*.test.mjs",
		"lint": "eslint src --max-warnings 0",
		"release": "node scripts/release.mjs",
		"release:dry-run": "node scripts/release.mjs --dry-run"
	},
	"dependencies": { "@1password/sdk": "0.5.0" },
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/node": "^22.15.17",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"obsidian": "1.14.4",
		"semantic-release": "^25.0.9",
		"typescript": "^5.8.3"
	},
	"overrides": { "eslint-plugin-obsidianmd": { "obsidian": "$obsidian" } }
}
