{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2020"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
